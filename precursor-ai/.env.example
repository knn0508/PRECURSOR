# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL / PostGIS (used by the postgres container) ---
POSTGRES_USER=precursor
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=precursor
# Host port published for the database (local tools / tests)
POSTGRES_HOST_PORT=55432

# --- Backend ---
# Local (backend run on host):   postgresql+psycopg://USER:PASSWORD@localhost:55432/DB
# Docker Compose overrides host to the service name `postgres`.
DATABASE_URL=postgresql+psycopg://precursor:change-me-locally@localhost:55432/precursor
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# URL the BROWSER uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Phase 2: NASA data acquisition -------------------------------------------------
# Earthdata Login (https://urs.earthdata.nasa.gov/). Needed ONLY to download files;
# catalog search/discovery works without it. Alternatively use ~/.netrc. Never commit real values.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Where raw NASA files and provenance manifests are stored (inside Docker this is /data)
DATA_ROOT=./data
# AOI_DIR=./data/aoi

# NISAR products searched by default (GOFF and SME2 are optional extras)
NISAR_PRODUCTS=GUNW,GCOV,GSLC
# Strict by default. Add PROVISIONAL and/or BETA explicitly to include lower-maturity products.
ALLOWED_MATURITIES=VALIDATED

MAX_CONCURRENT_DOWNLOADS=2
REQUEST_TIMEOUT_S=60
DOWNLOAD_RETRIES=3
# A real NISAR GUNW granule is ~1.4 GB; 3 GiB default cap per file
MAX_FILE_SIZE_BYTES=3221225472
MAX_GRANULES_PER_REQUEST=10
# Reject AOIs wider/taller than this (degrees) to avoid accidental country-scale downloads
MAX_AOI_BBOX_DEGREES=5

ENABLE_NISAR=true
ENABLE_NASADEM=true
ENABLE_OPERA=true
ENABLE_GPM=true
ENABLE_SMAP=false
ENABLE_LANDSLIDE_CATALOG=true

# GPM IMERG temporal resolution: daily | half_hourly | monthly
GPM_RESOLUTION=daily
# SMAP collection short name (optional provider)
SMAP_COLLECTION=SPL3SMP_E

# --- Phase 3: InSAR processing ----------------------------------------------------------
# Reads files already on disk (Phase 2 downloads or data/samples/insar). Needs no credentials, never downloads.
INSAR_BLOCK_ROWS=256
INSAR_TIMEOUT_S=3600
INSAR_MIN_FREE_DISK_BYTES=1073741824
